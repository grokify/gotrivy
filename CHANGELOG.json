      "commit": "069e279",
      "highlights": [
        { "description": "Trivy reports now convert to the shared [findingspec](https://github.com/plexusone/findingspec) IR — normalized findings usable across scanners", "commit": "069e279" },
        { "description": "New `ScanFilepath` wrapper and `cmd/gotrivyscan` CLI run `trivy fs` and return a parsed report", "commit": "2fb760b" }
      ],
      "added": [
        { "description": "Trivy report → `findingspec.Finding` conversion (security domain) with typed CVSS, fix state, and package metadata", "commit": "069e279" },
        { "description": "`ScanFilepath` runs `trivy fs --format json --scanners vuln` via the installed trivy binary and returns the parsed `types.Report`", "commit": "2fb760b" },
